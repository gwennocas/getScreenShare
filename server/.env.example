# Dados do seu projeto no LiveKit Cloud (Settings > Keys)
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=suachave
LIVEKIT_API_SECRET=seusegredo

# Código que seus amigos digitam nas configurações do app.
# Sem ele, qualquer pessoa que achar o servidor gasta a sua cota do LiveKit.
ACCESS_CODE=troque-este-codigo

# Porta do servidor (muitas hospedagens definem isso sozinhas)
PORT=8787

# Coloque 1 se o servidor ficar atrás de um proxy (Render, Railway, nginx...)
TRUST_PROXY=0
