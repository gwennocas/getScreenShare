{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getScreenShare",
  "version": "0.4.4",
  "identifier": "com.getscreenshare.app",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-tauri-frontend.js",
    "beforeBuildCommand": "node ../scripts/prepare-tauri-frontend.js",
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "getScreenShare", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600, "decorations": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' wss: https:; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" } }
  }
}
