{
  "name": "getscreenshare",
  "version": "0.2.0",
  "description": "Compartilhamento de tela em tempo real (Electron + LiveKit)",
  "main": "main.js",
  "author": "getScreenShare",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.getscreenshare.app",
    "productName": "getScreenShare",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "token.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "getScreenShare"
    }
  }
}
