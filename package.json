{
  "name": "getscreenshare",
  "version": "0.2.1",
  "description": "Compartilhamento de tela em tempo real (Electron + LiveKit)",
  "main": "main.js",
  "author": "getScreenShare",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.23.0",
    "wasapi-loopback": "github:thomas-quant/wasapi-loopback#main"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.getscreenshare.app",
    "productName": "getScreenShare",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "token.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/wasapi-loopback/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "getScreenShare"
    },
    "asarUnpack": [
      "node_modules/wasapi-loopback/**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gwennocas",
        "repo": "getScreenShare",
        "releaseType": "release"
      }
    ]
  }
}
