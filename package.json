{
  "name": "getscreenshare",
  "version": "0.2.6",
  "description": "Compartilhamento de tela em tempo real (Electron + LiveKit)",
  "main": "main.js",
  "author": "getScreenShare",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "dist:win": "electron-builder --win",
    "dist:deb": "electron-builder --linux deb",
    "test": "node --test test/*.test.js",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "livekit-client": "2.23.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.getscreenshare.app",
    "productName": "getScreenShare",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "video-runtime.js",
      "preload.js",
      "token.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/wasapi-loopback/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "getScreenShare-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "getScreenShare"
    },
    "asarUnpack": [
      "node_modules/wasapi-loopback/**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gwennocas",
        "repo": "getScreenShare",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "gwennocas <gwennocas@users.noreply.github.com>",
      "artifactName": "getScreenShare-${version}-linux-${arch}.${ext}"
    }
  },
  "optionalDependencies": {
    "wasapi-loopback": "github:thomas-quant/wasapi-loopback#main"
  }
}
